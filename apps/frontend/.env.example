# Frontend (Next.js). NEXT_PUBLIC_* values are inlined at build time.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
# "dev" shows /dev/tracking, the Dev nav link and the payment force-status buttons in a production build
NEXT_PUBLIC_APP_ENV=
# set to "false" to switch the tracking SDK off
NEXT_PUBLIC_TRACKING_ENABLED=true
