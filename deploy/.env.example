# Copy to deploy/.env and fill in. Used by infra.yml / services.yml (compose interpolation).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=postgres
JWT_SECRET=change-me-with-a-long-random-string
JWT_EXPIRE_TIME=5
KAFKA_PRODUCER_RETRY=2
KAFKA_PRODUCER_BACKOFF=100
KAFKA_CONSUMER_BACKOFF=100
# Public host name routed by Traefik
PUBLIC_HOST=marketplace.swarm.localhost
# Basic-auth (htpasswd, escape $ as $$) for the Traefik dashboard
TRAEFIK_DASHBOARD_USERS=

# Monitoring (deploy/observability.yml): Grafana at https://grafana.$PUBLIC_HOST (view-only dashboards, no alerting)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
PROMETHEUS_RETENTION=15d

# Platform administrator (created once by auth-service; 8-16 chars of letters/digits/underscore). Leave empty to create none.
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=

# Demo data (accounts buyer1/seller1 with password "password", sample products). Never enable in production.
SEED_DEMO_DATA=false

# Gateway hardening (optional)
# CIDR of the overlay network Traefik runs in; lets the gateway see real client IPs for rate limiting
TRUSTED_PROXIES=
RATE_LIMIT_PER_MINUTE=300
AUTH_RATE_LIMIT_PER_MINUTE=20

# Operational endpoints (every Go service: /health /healthz /ready /readyz /metrics /version on an internal-only port)
# ADMIN_PORT=8081
# DRAIN_SECONDS=10          # time /ready reports 503 before the server stops on SIGTERM
# READY_CACHE_SECONDS=3
# READY_CHECK_TIMEOUT_MS=1000
# PPROF_ENABLED=false

# Gateway request body cap in bytes (default 1 MiB); larger bodies get HTTP 413
# MAX_BODY_BYTES=1048576
