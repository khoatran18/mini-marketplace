# Copy to deploy/.env. Giá trị mặc định dưới đây chỉ dành cho chạy LOCAL (đã điền sẵn user/password). Lên prod phải đổi hết (dùng deploy/env/prod.env.example).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
JWT_SECRET=dev-jwt-secret-change-me-in-prod-0123456789
JWT_EXPIRE_TIME=5
KAFKA_PRODUCER_RETRY=2
KAFKA_PRODUCER_BACKOFF=100
KAFKA_CONSUMER_BACKOFF=100
# Public host name routed by Traefik
PUBLIC_HOST=marketplace.swarm.localhost
# http (mặc định local, không cần cert) | https (staging/prod: cần cert; deploy.sh gộp services.https.yml; build-images.sh nướng URL https vào frontend)
PUBLIC_SCHEME=http

# Basic-auth (htpasswd, escape $ as $$) for the Traefik dashboard
TRAEFIK_DASHBOARD_USERS=admin:$$apr1$$DzahaUDP$$b9YSXRdsJcbmBsIo682Xz/

# Monitoring (deploy/observability.yml): Grafana at https://grafana.$PUBLIC_HOST (view-only dashboards, no alerting)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
PROMETHEUS_RETENTION=15d
# Loki: giữ log bao lâu (bội số 24h; tối thiểu 24h)
LOKI_RETENTION=168h

# Platform administrator (created once by auth-service; 8-16 chars of letters/digits/underscore). Leave empty to create none.
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=Admin12345
# Operator (optional; read the system and propose ops actions, cannot approve/run). Same character rules as the admin.
OPERATOR_BOOTSTRAP_USERNAME=operator
OPERATOR_BOOTSTRAP_PASSWORD=Operator12345

# Outbox (domain_events): publish attempts before a row becomes DEAD (dead-letter), and retry backoff
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_BACKOFF_BASE=5s
OUTBOX_BACKOFF_MAX=15m

# Order rules (order-service)
# unpaid online orders expire and release their stock after this many minutes
ORDER_PAYMENT_TTL_MIN=15
# how long after delivery a return can be requested
RETURN_WINDOW_DAYS=7
# shipped orders become delivered after this many days (0 = off)
AUTO_DELIVER_DAYS=7
# per store order, in VND
SHIPPING_FLAT_FEE=30000
# store orders at or above this subtotal ship free (0 = never free)
FREE_SHIP_OVER=500000

# SIMULATED payments (payment-service). The provider is a mock: no real money, no real network.
PAYMENT_WEBHOOK_SECRET=dev-webhook-secret-123456
# wallet confirmation latency
MOCK_WEBHOOK_DELAY_MS=3000
# bank transfer confirmation latency
MOCK_TRANSFER_DELAY_MS=8000
# result of the "timeout" test card
MOCK_TIMEOUT_DELAY_MS=30000
# ENV=dev only: share of card attempts that fail with provider_error
PAYMENT_CHAOS_RATE=0
# dev enables the admin "force payment status" tool
ENV=prod

# Analytics (ClickHouse + analytics-service). Dashboards only; the shop works without them.
CLICKHOUSE_PASSWORD=clickhouse
CLICKHOUSE_USER=default
CLICKHOUSE_DB=marketplace
# report cache (Redis)
ANALYTICS_CACHE_TTL_SEC=30
# ClickHouse insert batching
ANALYTICS_FLUSH_INTERVAL_MS=2000
ANALYTICS_FLUSH_ROWS=5000
# in-RAM buffer while ClickHouse is down; beyond it rows go to the spool (or are dropped when it is disabled)
ANALYTICS_BUFFER_MAX_ROWS=100000
# durable spool (named volume) for rows ClickHouse could not take / unflushed at SIGTERM, replayed at startup; empty = disabled
ANALYTICS_SPOOL_DIR=/var/spool/analytics
# size cap of the spool; beyond it rows are dropped (mm_ch_rows_dropped_total)
ANALYTICS_SPOOL_MAX_MB=256
# TTL of raw clickstream events (facts are kept)
EVENTS_RETENTION_MONTHS=13
# POST /events per client IP
EVENTS_RATE_LIMIT_PER_MINUTE=120
# key of the daily-rotating IP hash stored with tracking events. Empty = random key per replica and per restart (still works, but unique-visitor counts can be inflated with several replicas); set a random value in prod: openssl rand -hex 32
# Giá trị mặc định cho LOCAL. Lên staging/prod hãy đổi: openssl rand -hex 32 (không dùng lại giá trị này)
IP_HASH_SECRET=dev-ip-hash-secret

# Demo data (accounts buyer1/seller1 with password "password", sample products). Never enable in production.
# local: bật; lên prod PHẢI đặt false
SEED_DEMO_DATA=true

# Gateway hardening (optional)
# CIDR of the overlay network Traefik runs in; lets the gateway see real client IPs for rate limiting
TRUSTED_PROXIES=
RATE_LIMIT_PER_MINUTE=300
AUTH_RATE_LIMIT_PER_MINUTE=20

# Operational endpoints (every Go service: /health /healthz /ready /readyz /metrics /version on an internal-only port)
# Bearer token required on :8081 /metrics, /version and pprof (probes /health /ready stay open); Prometheus is given the same value. Empty = open. CHANGE for prod, e.g. `openssl rand -hex 24`.
# Giá trị mặc định cho LOCAL (token này ai đọc repo cũng biết). Lên staging/prod hãy đổi: openssl rand -hex 24
METRICS_TOKEN=dev-metrics-token
ADMIN_PORT=8081
# time /ready reports 503 before the server stops on SIGTERM
DRAIN_SECONDS=10
READY_CACHE_SECONDS=3
READY_CHECK_TIMEOUT_MS=1000
PPROF_ENABLED=false

# Gateway request body cap in bytes (default 1 MiB); larger bodies get HTTP 413
MAX_BODY_BYTES=1048576

# Profile máy yếu: LITE=true => deploy.sh gộp deploy/services.lite.yml (gateway 1 replica, memory limit thấp hơn) + deploy/infra.lite.yml (Kafka 1 broker, RF=1; mặc định 3 broker, RF=3)
LITE=false

# Địa chỉ gRPC giữa các service (gateway, order-service). Mặc định đã đúng với stack; chỉ đổi khi tách mạng/đổi tên.
AUTH_SERVICE_ADDR=auth-service:50051
ORDER_SERVICE_ADDR=order-service:50052
PRODUCT_SERVICE_ADDR=product-service:50053
USER_SERVICE_ADDR=user-service:50054
ANALYTICS_SERVICE_ADDR=analytics-service:50055
PAYMENT_SERVICE_ADDR=payment-service:50057

# Nhiều môi trường: deploy/env/{dev,staging,prod}.env.example; chọn bằng DEPLOY_ENV=dev|staging|prod hoặc ENV_FILE=/đường/dẫn

# gRPC từ gateway: deadline (ms) và số lần thử tối đa (retry chỉ cho lệnh đọc)
GRPC_TIMEOUT_READ_MS=3000
GRPC_TIMEOUT_WRITE_MS=10000
# gateway: lỗi hạ tầng liên tiếp thì mở mạch tới service đó (0 = tắt)
CIRCUIT_FAILURE_THRESHOLD=5
# mở bao lâu trước khi thử lại một lời gọi
CIRCUIT_COOLDOWN_MS=10000
# RECONCILE_PG_DSN: mặc định tự dựng từ POSTGRES_*; đặt rỗng thì TẮT so sánh Postgres/ClickHouse, nên không liệt kê ở đây (rỗng khác chưa đặt).
RECONCILE_INTERVAL_SEC=600
RECONCILE_DAYS=2
RECONCILE_TOLERANCE=0.02
GRPC_RETRY_MAX_ATTEMPTS=3

# ADR-40: luồng chat AI (SSE) do gateway chuyển tiếp tới dịch vụ agent (tự xây). MẶC ĐỊNH TẮT; GET /config/features báo cờ cho UI.
FEATURE_AI_CHAT=false
FEATURE_AI_OPS=false
# gateway gọi POST <url>/chat; gửi X-Agent-Token, X-Agent-Run-ID, X-User-ID, X-User-Role (không gửi JWT người dùng khi có AGENT_TOKEN_KEYS)
AI_SERVICE_URL=http://ai-agent:8090
# tối đa cho một luồng
AI_STREAM_TIMEOUT_SEC=120
# giới hạn POST /ai/chat theo IP (0 = tắt); Redis lỗi thì từ chối (fail closed)
AI_RATE_LIMIT_PER_MINUTE=20
# POST /ai/chat theo người dùng (0 = tắt); fail closed
AI_USER_RATE_LIMIT_PER_MINUTE=10
# POST /ai/proposals và GET /ai/tools theo người dùng trong token agent (0 = tắt); fail closed
AI_PROPOSAL_RATE_LIMIT_PER_MINUTE=30
# ADR-42: khoá ký token agent + gói đề xuất hành động. "kid:secret,kid:secret": khoá ĐẦU để ký, các khoá sau chỉ để kiểm (xoay khoá:
# docs/instruction/03_RUNBOOK.md §18). Mỗi secret >= 32 ký tự, KHÁC JWT_SECRET. Để trống = tắt token agent và /ai/proposals.
# Tạo secret: openssl rand -hex 32   (không dán giá trị vào chat/repo)
AGENT_TOKEN_KEYS=
# ADR-47: khoá để ai-agent (bộ theo dõi RCA) xin token HỆ THỐNG chỉ đọc /ops/* tại POST /ai/system-token. Cùng giá trị cho gateway và ai-agent,
# >= 32 ký tự, KHÁC mọi khoá khác; cần AGENT_TOKEN_KEYS. Để trống = không có danh tính hệ thống (RCA không chạy được).
# Tạo: openssl rand -hex 32   (không dán giá trị vào chat/repo)
AI_SYSTEM_KEY=

# ADR-38: bí mật dùng chung gateway <-> ops-service (/ops/*). Sinh: openssl rand -hex 24. Trống = các route /ops/* trả 503.
OPS_API_TOKEN=
# ops-service (ADR-38): webhook thông báo (Slack/Discord/…) khi có sự cố mới hoặc đề xuất chờ duyệt. Trống = tắt.
OPS_NOTIFY_WEBHOOK_URL=
# Thực thi hành động đã duyệt (đợt 3). MẶC ĐỊNH TẮT; chỉ requeue_outbox tự chạy, các hành động `command` luôn do người chạy.
OPS_ACTIONS_ENABLED=false
# Narrow-scope token for the agent/orchestrator (must differ from OPS_API_TOKEN): openssl rand -hex 32
OPS_AGENT_TOKEN=
# tối đa lần tự chạy mỗi giờ
OPS_MAX_EXEC_PER_HOUR=5
# nghỉ giữa hai lần cùng hành động + service
OPS_EXEC_COOLDOWN_MIN=5
# quyết định duyệt chỉ có hiệu lực thực thi trong ngần này phút
OPS_EXEC_WINDOW_MIN=60

# --- ai-agent (services/ai-agent; chỉ cần khi FEATURE_AI_CHAT=true) ---
# chọn services/ai-agent/configs/config.<env>.yaml (profile LLM và role nằm trong file đó)
AI_AGENT_ENV=prod
# ADR-46: bật vòng lặp điều tra sự cố (true/false). Cần FEATURE_AI_OPS=true, AI_SYSTEM_KEY, và bật sẽ tự điều tra alert critical (tốn LLM)
AI_RCA_ENABLED=false
# Trần số phiên RCA TỰ chạy mỗi ngày cho sự cố critical (mỗi phiên tốn LLM). 0 = không tự chạy, chỉ chạy khi operator bấm Điều tra
AI_RCA_DAILY_AUTO_RUNS=10
# DEEPSEEK_API_KEY: chỉ cần cho profile bạn gán trong llm.roles; KHÔNG commit
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
OPENCODE_API_KEY=
# OPENCODE_BASE_URL để trống = https://opencode.ai/inference/go/openai/v1 (OpenCode Go)
OPENCODE_BASE_URL=
ANTHROPIC_API_KEY=
# Không đặt LANGSMITH_* / LANGCHAIN_TRACING_V2: ai-agent từ chối khởi động ở prod nếu có (nội dung chat không được gửi ra ngoài).
