# Copy to deploy/.env and fill in. Used by infra.yml / services.yml (compose interpolation).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=postgres
JWT_SECRET=change-me-with-a-long-random-string
JWT_EXPIRE_TIME=5
KAFKA_PRODUCER_RETRY=2
KAFKA_PRODUCER_BACKOFF=100
KAFKA_CONSUMER_BACKOFF=100
# Public host name routed by Traefik
PUBLIC_HOST=marketplace.swarm.localhost
# Basic-auth (htpasswd, escape $ as $$) for the Traefik dashboard
TRAEFIK_DASHBOARD_USERS=

# Monitoring (deploy/observability.yml): Grafana at https://grafana.$PUBLIC_HOST (view-only dashboards, no alerting)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
PROMETHEUS_RETENTION=15d

# Platform administrator (created once by auth-service; 8-16 chars of letters/digits/underscore). Leave empty to create none.
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=

# Order rules (order-service)
ORDER_PAYMENT_TTL_MIN=15        # unpaid online orders expire and release their stock after this many minutes
RETURN_WINDOW_DAYS=7            # how long after delivery a return can be requested
AUTO_DELIVER_DAYS=7             # shipped orders become delivered after this many days (0 = off)
SHIPPING_FLAT_FEE=30000         # per store order, in VND
FREE_SHIP_OVER=500000           # store orders at or above this subtotal ship free (0 = never free)

# SIMULATED payments (payment-service). The provider is a mock: no real money, no real network.
PAYMENT_WEBHOOK_SECRET=change-me-at-least-16-characters
MOCK_WEBHOOK_DELAY_MS=3000      # wallet confirmation latency
MOCK_TRANSFER_DELAY_MS=8000     # bank transfer confirmation latency
MOCK_TIMEOUT_DELAY_MS=30000     # result of the "timeout" test card
PAYMENT_CHAOS_RATE=0            # ENV=dev only: share of card attempts that fail with provider_error
ENV=prod                        # dev enables the admin "force payment status" tool

# Analytics (ClickHouse + analytics-service). Dashboards only; the shop works without them.
CLICKHOUSE_PASSWORD=change-me
CLICKHOUSE_USER=default
CLICKHOUSE_DB=marketplace
ANALYTICS_CACHE_TTL_SEC=30      # report cache (Redis)
EVENTS_RETENTION_MONTHS=13      # TTL of raw clickstream events (facts are kept)
EVENTS_RATE_LIMIT_PER_MINUTE=120  # POST /events per client IP
IP_HASH_SECRET=                 # key of the daily-rotating IP hash stored with tracking events (empty = random per replica)

# Demo data (accounts buyer1/seller1 with password "password", sample products). Never enable in production.
SEED_DEMO_DATA=false

# Gateway hardening (optional)
# CIDR of the overlay network Traefik runs in; lets the gateway see real client IPs for rate limiting
TRUSTED_PROXIES=
RATE_LIMIT_PER_MINUTE=300
AUTH_RATE_LIMIT_PER_MINUTE=20

# Operational endpoints (every Go service: /health /healthz /ready /readyz /metrics /version on an internal-only port)
# ADMIN_PORT=8081
# DRAIN_SECONDS=10          # time /ready reports 503 before the server stops on SIGTERM
# READY_CACHE_SECONDS=3
# READY_CHECK_TIMEOUT_MS=1000
# PPROF_ENABLED=false

# Gateway request body cap in bytes (default 1 MiB); larger bodies get HTTP 413
# MAX_BODY_BYTES=1048576
