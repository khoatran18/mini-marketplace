# Copy to deploy/.env and fill in. Used by infra.yml / services.yml (compose interpolation).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=postgres
JWT_SECRET=change-me-with-a-long-random-string
JWT_EXPIRE_TIME=5
KAFKA_PRODUCER_RETRY=2
KAFKA_PRODUCER_BACKOFF=100
KAFKA_CONSUMER_BACKOFF=100
# Public host name routed by Traefik
PUBLIC_HOST=marketplace.swarm.localhost
# Basic-auth (htpasswd, escape $ as $$) for the Traefik dashboard
TRAEFIK_DASHBOARD_USERS=

# Demo data (accounts buyer1/seller1 with password "password", sample products). Never enable in production.
SEED_DEMO_DATA=false

# Gateway hardening (optional)
# CIDR of the overlay network Traefik runs in; lets the gateway see real client IPs for rate limiting
TRUSTED_PROXIES=
RATE_LIMIT_PER_MINUTE=300
AUTH_RATE_LIMIT_PER_MINUTE=20
