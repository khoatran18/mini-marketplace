        {
          "expr": "100 * sum by (container_label_com_docker_swarm_service_name) (container_memory_working_set_bytes{container_label_com_docker_swarm_service_name!=\"\"}) / (sum by (container_label_com_docker_swarm_service_name) (container_spec_memory_limit_bytes{container_label_com_docker_swarm_service_name!=\"\"}) > 0)",
          "legendFormat": "{{container_label_com_docker_swarm_service_name}}",
          "refId": "A"
