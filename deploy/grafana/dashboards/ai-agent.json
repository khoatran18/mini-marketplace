{
 "uid": "mm-ai",
 "title": "Marketplace · AI agent",
 "tags": [
  "marketplace"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "15s",
 "time": {
  "from": "now-3h",
  "to": "now"
 },
 "templating": {
  "list": []
 },
 "panels": [
  {
   "type": "stat",
   "title": "ai-agent up",
   "description": "1 = scrape được; không có dữ liệu = target biến mất (AIAgentDown)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "id": 1,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "expr": "min(up{job=\"ai-agent\"})",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value"
   }
  },
  {
   "type": "stat",
   "title": "Lượt chat / giờ",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "id": 2,
   "gridPos": {
    "x": 6,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "expr": "sum(increase(mm_ai_runs_total[1h]))",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value"
   }
  },
  {
   "type": "stat",
   "title": "Tỉ lệ lượt lỗi (1h)",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "id": 3,
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "expr": "sum(increase(mm_ai_runs_total{status!=\"ok\"}[1h])) / clamp_min(sum(increase(mm_ai_runs_total[1h])), 1)",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.05
       },
       {
        "color": "red",
        "value": 0.2
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value"
   }
  },
  {
   "type": "stat",
   "title": "Token / giờ",
   "description": "vào + ra, mọi persona",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "id": 4,
   "gridPos": {
    "x": 18,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "expr": "sum(increase(mm_ai_tokens_total[1h]))",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value"
   }
  },
  {
   "type": "timeseries",
   "title": "Lượt chat theo persona và trạng thái",
   "description": "mỗi phút",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "id": 5,
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "expr": "sum by (persona, status) (rate(mm_ai_runs_total[5m]))*60",
     "legendFormat": "{{persona}} {{status}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   }
  },
  {
   "type": "timeseries",
   "title": "Token theo persona và chiều",
   "description": "mỗi phút",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "id": 6,
   "gridPos": {
    "x": 12,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "expr": "sum by (persona, direction) (rate(mm_ai_tokens_total[5m]))*60",
     "legendFormat": "{{persona}} {{direction}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   }
  },
  {
   "type": "timeseries",
   "title": "Thời gian một lượt (p50 / p95)",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "id": 7,
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.5, sum by (le, persona) (rate(mm_ai_run_duration_seconds_bucket[5m])))",
     "legendFormat": "p50 {{persona}}",
     "refId": "A"
    },
    {
     "expr": "histogram_quantile(0.95, sum by (le, persona) (rate(mm_ai_run_duration_seconds_bucket[5m])))",
     "legendFormat": "p95 {{persona}}",
     "refId": "B"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   }
  },
  {
   "type": "timeseries",
   "title": "Gọi mô hình: p95 và lỗi",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "id": 8,
   "gridPos": {
    "x": 12,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.95, sum by (le, profile) (rate(mm_ai_llm_call_seconds_bucket[5m])))",
     "legendFormat": "p95 {{profile}}",
     "refId": "A"
    },
    {
     "expr": "sum by (profile) (rate(mm_ai_llm_errors_total[5m]))",
     "legendFormat": "lỗi/s {{profile}}",
     "refId": "B"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   }
  },
  {
   "type": "timeseries",
   "title": "Gọi tool theo kết quả",
   "description": "mỗi phút; result=error tăng = tool hỏng hoặc gateway từ chối",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "id": 9,
   "gridPos": {
    "x": 0,
    "y": 20,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "expr": "sum by (tool, result) (rate(mm_ai_tool_calls_total[5m]))*60",
     "legendFormat": "{{tool}} {{result}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   }
  },
  {
   "type": "timeseries",
   "title": "Yêu cầu bị từ chối trước khi gọi mô hình",
   "description": "mỗi phút (hạn mức ngày, bận, quá dài...)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "id": 10,
   "gridPos": {
    "x": 12,
    "y": 20,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "expr": "sum by (persona, reason) (rate(mm_ai_rejected_total[5m]))*60",
     "legendFormat": "{{persona}} {{reason}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   }
  }
 ]
}