    {
      "type": "timeseries",
      "title": "Thời gian xử lý payment p50 / p95",
      "description": "histogram mm_payment_processing_seconds",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "id": 14,
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(mm_payment_processing_seconds_bucket[5m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(mm_payment_processing_seconds_bucket[5m])))",
          "legendFormat": "p95",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
