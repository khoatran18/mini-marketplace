      },
      "id": 11,
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "expr": "sum by (method) (increase(mm_payment_amount_minor_total[1h])) / 100",
          "legendFormat": "{{method}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyVND"
        },
        "overrides": []
