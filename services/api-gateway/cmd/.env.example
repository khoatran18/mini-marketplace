# Copy to .env (local run) or inject via the environment (docker).
JWT_SECRET=change-me-with-a-long-random-string
JWT_EXPIRE_TIME=5
REDIS_ADDR=localhost:6379
POSTGRES_DSN=host=localhost user=postgres password=change-me dbname=postgres port=5432 sslmode=disable
KAFKA_BROKERS_ADDR=localhost:9092
KAFKA_PRODUCER_RETRY=2
KAFKA_PRODUCER_BACKOFF=100
KAFKA_CONSUMER_BACKOFF=100
SEED_DEMO_DATA=false

# gRPC upstreams (optional; defaults are the swarm service names)
#AUTH_SERVICE_ADDR=auth-service:50051
#ORDER_SERVICE_ADDR=order-service:50052
#PRODUCT_SERVICE_ADDR=product-service:50053
#USER_SERVICE_ADDR=user-service:50054
#PAYMENT_SERVICE_ADDR=payment-service:50057
#ANALYTICS_SERVICE_ADDR=analytics-service:50055

# gRPC client deadline/retry (optional)
#GRPC_TIMEOUT_READ_MS=3000        # deadline mặc định cho method đọc (Get*/List*/Search*/Preview*/Query*...)
#GRPC_TIMEOUT_WRITE_MS=10000      # deadline mặc định cho method ghi
#GRPC_RETRY_MAX_ATTEMPTS=3        # tổng số lần gọi (gồm lần đầu), chỉ method đọc + codes.Unavailable
