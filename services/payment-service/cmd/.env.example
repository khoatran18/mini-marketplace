# Copy to .env (local run) or inject via the environment (docker).
REDIS_ADDR=localhost:6379
POSTGRES_DSN=host=localhost user=postgres password=change-me dbname=postgres port=5432 sslmode=disable
KAFKA_BROKERS_ADDR=localhost:9092
KAFKA_PRODUCER_RETRY=3
KAFKA_PRODUCER_BACKOFF=100
KAFKA_CONSUMER_BACKOFF=100
# Payments are SIMULATED only; "mock" is the only supported mode.
PAYMENTS_MODE=mock
# Webhook URL defaults to this service's admin port (ADMIN_PORT); HMAC key is required (>= 16 chars).
#PAYMENT_WEBHOOK_URL=http://127.0.0.1:8081/internal/payments/webhook
PAYMENT_WEBHOOK_SECRET=change-me-with-a-long-random-string
ADMIN_PORT=8081
# Simulated provider delays (ms)
MOCK_WEBHOOK_DELAY_MS=3000
MOCK_TRANSFER_DELAY_MS=8000
MOCK_TIMEOUT_DELAY_MS=30000
# Dev only: share (0..1] of card attempts failing with provider_error; ENV=dev enables dev behaviour.
#ENV=dev
#PAYMENT_CHAOS_RATE=0
#PPROF_ENABLED=false
