# Copy to .env (local run) or inject via the environment (docker).
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_DB=marketplace
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
REDIS_ADDR=localhost:6379
KAFKA_BROKERS_ADDR=localhost:9092
KAFKA_CONSUMER_BACKOFF=100
ANALYTICS_CACHE_TTL_SEC=30
ANALYTICS_FLUSH_INTERVAL_MS=2000
ANALYTICS_FLUSH_ROWS=5000
ANALYTICS_BUFFER_MAX_ROWS=100000
# Retention of raw events (months)
EVENTS_RETENTION_MONTHS=13
#PPROF_ENABLED=false
