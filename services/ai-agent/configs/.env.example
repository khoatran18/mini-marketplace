# Tên biến của ai-agent. Giá trị thật đặt trong deploy/.env (hoặc .env cục bộ, đã bị .gitignore chặn). Không commit khoá.
APP_ENV=dev
GATEWAY_URL=http://localhost:8080
# chỉ cần cho profile bạn thực sự dùng:
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
OPENCODE_API_KEY=
OPENCODE_BASE_URL=   # để trống = https://opencode.ai/inference/go/openai/v1
ANTHROPIC_API_KEY=
# KHÔNG đặt AGENT_TOKEN_KEYS ở đây: khoá ký chỉ gateway giữ. LangSmith: không đặt LANGSMITH_* / LANGCHAIN_TRACING_V2 (xem docs/ai/08 §14).
